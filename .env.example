# Copy to .env and fill in. Never commit the real .env.

# --- Resume matching (NVIDIA API catalog, OpenAI-compatible) -------------
# Get a key at https://build.nvidia.com/ -> any model page -> "Get API Key".
# Without a key the app still runs, using local keyword scoring instead.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Any catalog model works, e.g. nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# or meta/llama-3.3-70b-instruct.
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Generation settings. For reasoning models MATCHER_MAX_TOKENS must cover the
# thinking pass *and* the JSON answer, or the reply gets truncated before any
# JSON is produced. MATCHER_REASONING_BUDGET is ignored by non-reasoning models.
MATCHER_MAX_TOKENS=4096
MATCHER_REASONING_BUDGET=2048
MATCHER_TEMPERATURE=0.6
MATCHER_TOP_P=0.95

# How many jobs are scored in parallel, and how hard we retry.
MATCHER_CONCURRENCY=3
MATCHER_MAX_RETRIES=3
MATCHER_TIMEOUT_MS=120000
MAX_DESCRIPTION_CHARS=6000

# --- Candidate profile ---------------------------------------------------
TARGET_ROLE=Full Stack / Mobile Developer
# Optional: path to a plain-text resume; falls back to ./resume.txt, then to
# the built-in default in config/profile.js.
# RESUME_PATH=./resume.txt

# --- Server / scheduler --------------------------------------------------
PORT=3000
# Daily at midnight. Any 5-field cron expression works.
CRON_SCHEDULE=0 0 * * *
# Optional IANA timezone for the cron job, e.g. Asia/Kolkata.
# CRON_TIMEZONE=Asia/Kolkata
# Set true to scrape once immediately on boot (handy for first run).
RUN_ON_STARTUP=false

# --- Scraper -------------------------------------------------------------
# Comma-separated source ids from config/sources.js. Empty = use the
# `enabled` flags in that file.
# ENABLED_SOURCES=mock-board,remoteok
SCRAPER_TIMEOUT_MS=20000
SCRAPER_MAX_RETRIES=3
SCRAPER_MIN_DELAY_MS=800
SCRAPER_MAX_DELAY_MS=2200
REMOTEOK_MAX_JOBS=15

# --- Storage -------------------------------------------------------------
# Relative to the project root.
# DB_PATH=jobs.sqlite
