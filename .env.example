# Copy to .env and fill in. Never commit the real .env.

# --- Database (required) -------------------------------------------------
# PostgreSQL connection string. On Render, paste the database's Internal
# Connection String; locally this can be a Docker container:
#   docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:16
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobbot
# TLS: auto-detected (off for localhost, on for hosted). Force with true/false.
# DATABASE_SSL=false
PG_POOL_MAX=10

# --- Authentication (required) -------------------------------------------
# Any random string of 16+ characters. Rotating it invalidates all sessions.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
MIN_PASSWORD_LENGTH=8

# --- Matching (NVIDIA API catalog, OpenAI-compatible) --------------------
# Get a key at https://build.nvidia.com/ -> any model page -> "Get API Key".
# Without a key the app still runs, using local keyword scoring instead.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Any catalog model works. This one answers in ~3s and follows the strict-JSON
# contract reliably. Alternatives: nvidia/llama-3.3-nemotron-super-49b-v1.5
# (slower) or meta/llama-3.3-70b-instruct (currently times out on the public
# endpoint - check before switching to it).
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Generation settings. For reasoning models (e.g. nvidia/nemotron-*)
# MATCHER_MAX_TOKENS must cover the thinking pass *and* the JSON answer;
# MATCHER_REASONING_BUDGET is ignored by instruct models.
MATCHER_MAX_TOKENS=65536
MATCHER_REASONING_BUDGET=16384
MATCHER_TEMPERATURE=0.6
MATCHER_TOP_P=0.95

# --- Relevance gate ------------------------------------------------------
# How many rungs above the candidate a posting may sit and still be shown.
# 1 = an entry-level candidate sees mid-level roles, but not senior or staff.
# Roles in another field, or in a country the candidate is not in, are rejected
# outright and never reach the LLM. All three facts are derived from the
# uploaded resumes - inspect them at GET /api/resumes/profile.
RELEVANCE_MAX_LEVEL_STRETCH=1

# --- Compensation bar ----------------------------------------------------
# A posting is only recommended when the pay it advertises clears the floor.
# CTC is higher because it bundles PF, gratuity, insurance, bonus and ESOPs -
# a 15 LPA CTC is roughly a 10 LPA base salary.
MIN_LPA_SALARY=10
MIN_LPA_CTC=15
# Internships are exempt by default: a stipend is monthly, never LPA.
INTERNSHIP_ENFORCE_PAY=false
# Foreign pay is converted to LPA with these rates. A stale rate silently
# changes which jobs pass, so review them occasionally.
INR_PER_USD=88
INR_PER_EUR=95
INR_PER_GBP=112

# How many postings are matched in parallel, and how hard we retry.
MATCHER_CONCURRENCY=3
MATCHER_MAX_RETRIES=3
MATCHER_TIMEOUT_MS=120000
# A posting scoring below this is never written to the database. The crawl is
# open-ended, so most of what it discovers is a near-miss; storing all of it
# buries the rows that are worth an evening.
MIN_MATCH_SCORE=50
MAX_DESCRIPTION_CHARS=6000
# Prompt budget per resume, and how many resumes are sent per call.
MAX_RESUME_CHARS=4000
MAX_RESUMES_PER_CALL=6

# --- Resume uploads ------------------------------------------------------
MAX_RESUME_BYTES=5242880
MAX_RESUMES_PER_UPLOAD=10

# --- Server / scheduler --------------------------------------------------
PORT=3000
# Any 5-field cron expression. */30 = every half hour, 0 0 * * * = daily at
# midnight. Overlapping runs are impossible: a trigger that fires while a scrape
# is in flight is skipped, and only postings the tenant has not seen before cost
# an LLM call, so a frequent schedule stays cheap after the first run.
CRON_SCHEDULE=*/30 * * * *
# Optional IANA timezone for the cron job, e.g. Asia/Kolkata.
# CRON_TIMEZONE=Asia/Kolkata
# Set true to scrape once immediately on boot (handy for the first run).
RUN_ON_STARTUP=false

# --- Scraper -------------------------------------------------------------
# Which discovery channels run. Empty = all three.
#   ats-api      Greenhouse / Lever / Ashby / Workday public JSON endpoints
#   job-feeds    RemoteOK, Arbeitnow, HN "Who is hiring?" (mined for ATS links)
#   search-crawl Puppeteer + search-engine dorks, which is what finds new boards
# ENABLED_CHANNELS=ats-api,job-feeds
# Replaces the trusted ATS domain list in config/sources.js. A posting whose
# apply URL is not on one of these domains is discarded, whatever found it.
# TRUSTED_ATS_DOMAINS=greenhouse.io,lever.co,ashbyhq.com,myworkdayjobs.com
# Restrict the search crawl to particular engines (see config/sources.js).
# SEARCH_ENGINE=brave,duckduckgo-html

# How much one run is allowed to do. These matter more than CRON_SCHEDULE for
# how polite the crawler is.
SCRAPER_MAX_BOARDS=40
SCRAPER_MAX_NEW_JOBS=150
SCRAPER_MAX_DORKS=6
# Below ~5s between queries the search engines start serving throttle pages.
SCRAPER_SEARCH_DELAY_MS=6000
# Share of a run's posting budget reserved for the job feeds, so the ATS channel
# cannot consume the whole run.
SCRAPER_FEED_SHARE=0.25
# Skills taken from the resumes to build queries and dorks from.
MAX_SEARCH_SKILLS=12
# Postings kept per board, and per employer across the whole run. The second is
# what stops a board with 40 matching openings from filling the run by itself -
# raise it only if you would rather go deep at one company than wide.
MAX_JOBS_PER_SOURCE=8
SCRAPER_MAX_PER_COMPANY=5
SCRAPER_TIMEOUT_MS=30000
SCRAPER_SELECTOR_TIMEOUT_MS=10000
SCRAPER_MIN_DELAY_MS=800
SCRAPER_MAX_DELAY_MS=2200
# How many job pages are opened per board to read the full description.
SCRAPER_DETAIL_LIMIT=3

# --- Puppeteer / Docker --------------------------------------------------
# Set in the Dockerfile; leave unset locally so Puppeteer uses its own build.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
