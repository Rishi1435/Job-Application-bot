{
  "name": "job-application-bot",
  "version": "2.0.0",
  "description": "Multi-tenant job automation bot: scrapes trusted company career pages, categorises roles as Internship or Full-Time with an NVIDIA-hosted LLM, scores them against each user's resumes and serves them on a dashboard with Excel export.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "scrape": "node scripts/scrape.js",
    "verify": "node tests/verify.js",
    "test": "node --test tests/units.test.js tests/compensation.test.js tests/relevance.test.js",
    "rescreen": "node scripts/rescreen.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rishi1435/Job-Application-bot.git"
  },
  "keywords": [
    "job-scraper",
    "resume-matching",
    "puppeteer",
    "postgresql",
    "multi-tenant",
    "llm"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Rishi1435/Job-Application-bot/issues"
  },
  "homepage": "https://github.com/Rishi1435/Job-Application-bot#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "openai": "^6.49.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "puppeteer": "^24.43.1"
  },
  "engines": {
    "node": ">=20"
  }
}
